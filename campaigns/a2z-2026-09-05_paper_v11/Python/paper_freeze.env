# Common freeze for Fig1–8 campaign (THIS repo).
# Principle: every figure shares ONE working baseline; each fig changes ONE axis only.
# Version: common_freeze_v11
# Gate: Fig1 ON must beat OFF (goal and/or safety). Hub: goal≥90%, low coll, C~≥80%.
#
# v11 after v10 FAIL (mean dGoal -0.9pp; s42 -1.9, s43 -0.3, s44 -0.4).
# Keep: reward_range=DETECTION_RANGE; curriculum @9M; threat=0.45 (v10 avoided post-comm shock).
# Diagnosis: softening threat/consumer stopped s42 collapse but left messages under-used for
# goal — all seeds ON≈OFF−ε. Push goal-comm + consumer so channel must carry/decode partner goals.

# --- structure ---
VESSEL_USE_MOE=1
VESSEL_MOE_SHARED=1
VESSEL_MOE_WIDTH=1.0

# --- message / sensors ---
VESSEL_MSG_DIM=6
VESSEL_RADAR_RANGE=56
VESSEL_COMM_RANGE=420
VESSEL_POS_GROUND=1
VESSEL_USE_ATTENTION=0
VESSEL_USE_COMM=1
VESSEL_RADAR_ACT=leaky

# --- aux: keep mild threat; boost goal-use path ---
VESSEL_THREAT_COEF=0.45
VESSEL_INTENT_COEF=0
VESSEL_ROLE_COMM_COEF=0
VESSEL_GOAL_COMM_COEF=0.18
VESSEL_COMM_CONSUMER_COEF=0.15
VESSEL_COMM_CONSUMER_COUPLING=1
VESSEL_STATE_RECON_COEF=0
VESSEL_COLREGS_PRIMARY_ALIGN=0

# --- reward ---
VESSEL_PROGRESS_COEF=1.5
VESSEL_ARRIVAL_REWARD=120
VESSEL_COLLISION_PENALTY=-450
VESSEL_PROX_COEF=-2.0
VESSEL_PROXRAMP_COEF=-2.0
VESSEL_SIM_COLREGS_COEF=0.45

# --- eval PRIMARY ---
VESSEL_EVAL_PRIMARY_SO_OFF_DEG=25
VESSEL_EVAL_PRIMARY_OFF_DEG=10
VESSEL_EVAL_PRIMARY_SPD_DROP=0.15

PYTHONUNBUFFERED=1
